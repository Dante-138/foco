{
  "name": "foco",
  "version": "0.1.0",
  "private": true,
  "description": "App pessoal de organização: rotinas, hábitos e tarefas em um lugar só",
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-test-coverage \"--test-coverage-include=www/js/nucleo/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"tests/unidade/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.js\"",
    "commits": "node tools/verificar-commits.mjs origin/main",
    "check": "npm run lint && npm run format:check && npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  }
}
